# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ────────────────────────────────────────
# Local Postgres example:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/buzztech
#
# Supabase example (Project Settings → Database → Connection string → URI):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Set to true only if your provider requires SSL (Supabase/Render/Railway managed DBs do)
DB_SSL=true

# ── Auth ────────────────────────────────────────────
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ── CORS ────────────────────────────────────────────
# The deployed frontend URL (comma-separate if multiple, e.g. local + prod)
FRONTEND_ORIGIN=http://localhost:5173

# ── First Admin Seed (used only by `npm run seed-admin`) ──
SEED_ADMIN_NAME=Joint Coordinator
SEED_ADMIN_EMAIL=admin@buzztech.local
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
